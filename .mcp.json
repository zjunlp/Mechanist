{
  "mcpServers": {
    "llm-chat": {
      "cwd": ".",
      "command": "python3",
      "args": [
        "mcp-servers/launch_server.py",
        "llm-chat"
      ],
      "env_vars": [
        "LLM_API_KEY",
        "LLM_BASE_URL",
        "LLM_MODEL",
        "LLM_FALLBACK_MODEL"
      ]
    },
    "mechanic-db": {
      "cwd": ".",
      "command": "python3",
      "args": [
        "mcp-servers/launch_server.py",
        "mechanic-db"
      ],
      "env_vars": [
        "MECHANIC_DB_API_KEY",
        "MECHANIC_DB_BASE_URL"
      ]
    }
  }
}
