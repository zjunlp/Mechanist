# Local secrets — never commit. The root .mcp.json is a committed plugin
# descriptor containing environment-variable names only, never secret values.
!.mcp.json
.env
.env.*
*.local
secrets/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Per-experiment local state (except project-scoped Codex custom agents)
.claude/
.codex/
!.codex/
!.codex/agents/
!.codex/agents/*.toml

exp/

# Local-only working notes / judge prompts — don't ship
log.md
novelty_judge.md
next-round.md

# Never ship — local-only
backup.md
example.json
gate.md
